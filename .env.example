# Site Configuration
NEXT_PUBLIC_SITE_URL=https://growthbridgeaccelerator.com

# Supabase (PostgreSQL, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend Email Integration
RESEND_API_KEY=re_your_api_key
ADMIN_NOTIFICATION_EMAIL=hello@growthbridgeaccelerator.com
EMAIL_FROM="Growth Bridge Accelerator <hello@growthbridgeaccelerator.com>"

# Google Analytics 4 (Loaded only after user cookie consent)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Optional CRM Webhook (Dispatches on new lead)
LEAD_WEBHOOK_URL=https://your-crm-webhook-endpoint.com

# Security & Rate Limiting Salt
IP_HASH_SALT=your_random_secret_salt_string_here
